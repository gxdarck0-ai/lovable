{
  "manifest_version": 3,
  "name": "KMT-UNLMT1",
  "version": "6.0",
  "description": "KMT-UNLMT1 — Next-Gen Cyber Suite with Native Chat, Watermark Bypass, and Unlimited Prompts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://io.eklas.dev/*"
  ],
  "action": {
    "default_title": "KMT-UNLMT1",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.lovable.dev/*", "https://lovable.dev/*"],
      "js": ["scripts/content/page-ws.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*",
        "https://api.lovable.dev/*"
      ],
      "js": [
        "scripts/shared/fingerprint.js",
        "scripts/shared/flow.js",
        "scripts/shared/translations.js",
        "scripts/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo-square.png",
        "assets/icon16.png",
        "assets/icon32.png",
        "assets/icon48.png",
        "assets/icon128.png"
      ],
      "matches": ["https://*.lovable.dev/*", "https://lovable.dev/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src https://io.eklas.dev https://*.lovable.dev https://api.lovable.dev; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; media-src 'self'"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
